#:import max builtins.max

<ScanScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # ── Header ────────────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(45)
            padding: [dp(10), 0]
            canvas.before:
                Color:
                    rgba: 0.043, 0.071, 0.094, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'Scan Document'
                bold: True
                halign: 'left'
                text_size: self.size
                valign: 'middle'
            Label:
                text: root.page_info
                size_hint_x: None
                width: dp(90)
                font_size: '12sp'
                color: 0.7, 0.7, 0.7, 1

        # ── Status bar (scanner state + scan progress) ────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(28)
            padding: [dp(10), 0]
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 0.043, 0.071, 0.094, 0.85
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Scanner found / not found indicator
            Label:
                text: ('✓ Scanner ready' if root.scanner_found
                        else ('⚠ ' + root.no_device_msg if root.no_device_msg
                            else 'Searching for scanner…'))
                font_size: '11sp'
                color: ((0.18, 0.8, 0.44, 1) if root.scanner_found
                        else (1, 0.55, 0.2, 1))
                halign: 'left'
                text_size: self.size
                valign: 'middle'

            # Live scan progress message
            Label:
                text: root.scan_progress
                font_size: '11sp'
                color: 0.573, 0.678, 0.788, 1
                halign: 'right'
                text_size: self.size
                valign: 'middle'
                size_hint_x: 0.5

        # ── Main body ─────────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 1
            padding: dp(8)
            spacing: dp(12)

            # ── Left: preview list OR no-device placeholder ───────────────────
            BoxLayout:
                size_hint_x: 0.65
                orientation: 'vertical'
                padding: dp(2)
                canvas.before:
                    Color:
                        rgba: 0.043, 0.071, 0.094, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [6]

                # No device placeholder (visible when no scanner found)
                BoxLayout:
                    size_hint_y: None
                    height: dp(120) if (not root.scanner_found and not root.is_scanning) else dp(0)
                    opacity: 1 if (not root.scanner_found and not root.is_scanning) else 0
                    orientation: 'vertical'
                    padding: dp(16)
                    spacing: dp(8)

                    Label:
                        text: '⚠'
                        font_size: '28sp'
                        color: 1, 0.6, 0.2, 1
                        size_hint_y: None
                        height: dp(36)
                        halign: 'center'

                    Label:
                        text: root.no_device_msg or 'No scanner detected'
                        font_size: '12sp'
                        color: 1, 0.7, 0.4, 1
                        halign: 'center'
                        text_size: self.size
                        valign: 'top'

                    Button:
                        text: 'Refresh Scanner'
                        size_hint_y: None
                        height: dp(36)
                        font_size: '12sp'
                        background_color: 0, 0, 0, 0
                        on_release: root.rediscover_scanner()
                        canvas.before:
                            Color:
                                rgba: 0.137, 0.267, 0.388, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [6]

                # Thumbnail scroll area (always present; empty when no pages)
                ScrollView:
                    id: scroll_container
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: dp(4)

                    GridLayout:
                        id: thumbnail_grid
                        cols: 1
                        spacing: dp(10)
                        padding: dp(10)
                        size_hint_y: None
                        height: max(dp(80), self.minimum_height)

                # Empty-batch hint when scanner IS found but no pages yet
                Label:
                    text: 'Tap + PAGE to scan'
                    font_size: '12sp'
                    color: 0.4, 0.5, 0.6, 1
                    size_hint_y: None
                    height: dp(32) if (root.scanner_found and not root.scanned_images) else dp(0)
                    opacity: 1 if (root.scanner_found and not root.scanned_images) else 0
                    halign: 'center'

            # ── Right: control buttons ────────────────────────────────────────
            BoxLayout:
                size_hint_x: 0.35
                orientation: 'vertical'
                spacing: dp(10)

                Button:
                    text: 'BACK'
                    font_size: '11sp'
                    size_hint_y: 0.8
                    background_color: 0, 0, 0, 0
                    on_release: root.go_back()
                    canvas.before:
                        Color:
                            rgba: 0.2, 0.1, 0.1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

                # + PAGE (disabled when scanning or no scanner)
                Button:
                    text: '+ PAGE'
                    font_size: '11sp'
                    size_hint_y: 1
                    background_color: 0, 0, 0, 0
                    disabled: root.is_scanning or not root.scanner_found
                    on_release: root.add_page()
                    canvas.before:
                        Color:
                            rgba: (0.1, 0.2, 0.3, 1) if self.disabled else (0.137, 0.267, 0.388, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

                # DEL
                Button:
                    text: 'DEL'
                    font_size: '11sp'
                    size_hint_y: 1
                    background_color: 0, 0, 0, 0
                    disabled: root.is_scanning or not root.scanned_images
                    on_release: root.delete_page()
                    canvas.before:
                        Color:
                            rgba: (0.1, 0.2, 0.3, 1) if self.disabled else (0.137, 0.267, 0.388, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

                # DONE / UPLOAD
                Button:
                    text: 'DONE'
                    font_size: '13sp'
                    bold: True
                    size_hint_y: 1.8
                    background_color: 0, 0, 0, 0
                    disabled: root.is_scanning or not root.scanned_images
                    on_release: root.upload()
                    canvas.before:
                        Color:
                            rgba: (0.1, 0.3, 0.1, 1) if self.disabled else SUCCESS_COLOR
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

        # ── Bottom status bar ─────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(26)
            padding: [dp(10), 0]
            canvas.before:
                Color:
                    rgba: 0.043, 0.071, 0.094, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: root.status_msg
                font_size: '11sp'
                bold: True
                color: (0.18, 0.8, 0.44, 1) if root.status_msg.startswith('READY') else (0.573, 0.678, 0.788, 1)
                halign: 'left'
                text_size: self.size
                valign: 'middle'
