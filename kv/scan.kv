#:import max builtins.max

# scan.kv — 800x480 layout
# Preview list takes more horizontal real estate; controls column is wider.

<ScanScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # ── Header ──────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            padding: [dp(20), 0]
            canvas.before:
                Color:
                    rgba: 0.043, 0.071, 0.094, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'Scan Document'
                font_size: '18sp'
                bold: True
                halign: 'left'
                text_size: self.size
                valign: 'middle'
            Label:
                text: root.page_info
                size_hint_x: None
                width: dp(100)
                font_size: '13sp'
                color: TEXT_MUTED
                halign: 'right'
                text_size: self.size
                valign: 'middle'

        # ── Body ────────────────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 1
            padding: dp(12)
            spacing: dp(16)

            # Left: page thumbnail list (wider on 800px)
            BoxLayout:
                size_hint_x: 0.72
                orientation: 'vertical'
                padding: dp(2)
                canvas.before:
                    Color:
                        rgba: 0.043, 0.071, 0.094, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: dp(4)

                    GridLayout:
                        id: thumbnail_grid
                        cols: 1
                        spacing: dp(12)
                        padding: dp(12)
                        size_hint_y: None
                        height: max(dp(80), self.minimum_height)

            # Right: action buttons (more comfortable width)
            BoxLayout:
                size_hint_x: 0.28
                orientation: 'vertical'
                spacing: dp(12)

                Button:
                    text: 'BACK'
                    font_size: '13sp'
                    size_hint_y: 0.8
                    background_color: (0, 0, 0, 0)
                    on_release: root.go_back()
                    canvas.before:
                        Color:
                            rgba: (0.2, 0.1, 0.1, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]

                Button:
                    text: '+ PAGE'
                    font_size: '13sp'
                    size_hint_y: 1
                    background_color: (0, 0, 0, 0)
                    disabled: root.is_scanning
                    on_release: root.add_page()
                    canvas.before:
                        Color:
                            rgba: (0.1, 0.2, 0.3, 1) if self.disabled else (0.137, 0.267, 0.388, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]

                Button:
                    text: 'DEL'
                    font_size: '13sp'
                    size_hint_y: 1
                    background_color: (0, 0, 0, 0)
                    disabled: root.is_scanning or not root.scanned_images
                    on_release: root.delete_page()
                    canvas.before:
                        Color:
                            rgba: (0.1, 0.2, 0.3, 1) if self.disabled else (0.137, 0.267, 0.388, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]

                Button:
                    text: 'DONE'
                    font_size: '15sp'
                    bold: True
                    size_hint_y: 1.8
                    background_color: (0, 0, 0, 0)
                    disabled: root.is_scanning or not root.scanned_images
                    on_release: root.upload()
                    canvas.before:
                        Color:
                            rgba: (0.1, 0.3, 0.1, 1) if self.disabled else SUCCESS_COLOR
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
