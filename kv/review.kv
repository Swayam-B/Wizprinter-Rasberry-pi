#:import dp kivy.metrics.dp

<StudentCard>:
    orientation: 'vertical'
    size_hint: None, None
    size: dp(184), dp(120)
    padding: dp(10)
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: (0.137, 0.267, 0.388, 1) if root.is_selected else BG_CARD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]
        Color:
            rgba: root.status_color
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
            width: 1.4

    Label:
        text: root.student_name
        font_size: '13sp'
        bold: True
        color: WHITE
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        size_hint_y: None
        height: dp(22)

    Label:
        text: root.status_label
        font_size: '11sp'
        bold: True
        color: root.status_color
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        size_hint_y: None
        height: dp(18)

    Label:
        text: root.flag_summary
        font_size: '10sp'
        color: TEXT_MUTED
        text_size: self.size
        halign: 'left'
        valign: 'top'


<ReviewScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        StatusBar:
            size_hint_y: None
            height: dp(45)
            title: 'Review & Approve'
            show_back: True
            on_back: root.go_back()

        BoxLayout:
            size_hint_y: None
            height: dp(24)
            padding: ['14dp', '0dp']
            Label:
                text: root.summary_text
                font_size: '12sp'
                bold: True
                color: PRIMARY_COLOR
                text_size: self.size
                halign: 'left'
                valign: 'middle'

        # ── Auto-grouping chips (client-side heuristic groupings) ───────────
        BoxLayout:
            id: group_chip_row
            size_hint_y: None
            height: dp(36)
            padding: ['14dp', '2dp']
            spacing: '8dp'

        # ── Student card / tile grid ─────────────────────────────────────────
        ScrollView:
            size_hint_y: 1
            do_scroll_x: False
            GridLayout:
                id: card_grid
                cols: 2
                spacing: dp(10)
                padding: dp(14)
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(120)
                row_force_default: False

        # ── Bulk selection + finalize actions ────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: ['14dp', '6dp']
            spacing: '8dp'

            Button:
                text: 'Select All'
                font_size: '12sp'
                on_release: root.select_all()

            Button:
                text: 'Clear'
                font_size: '12sp'
                on_release: root.clear_selection()

            Button:
                text: 'Approve Selected'
                font_size: '12sp'
                bold: True
                background_color: (0.18, 0.8, 0.44, 1)
                on_release: root.approve_selected()

            Button:
                text: 'Finalize & Send'
                font_size: '13sp'
                bold: True
                background_color: (0.075, 0.498, 0.925, 1)
                on_release: root.finalize()

    FloatLayout:
        size_hint: 1, 1
        opacity: 1 if root.show_success else 0
        disabled: not root.show_success

        canvas.before:
            Color:
                rgba: (0, 0, 0, 0.85) if root.show_success else (0, 0, 0, 0)
            Rectangle:
                pos: self.pos
                size: self.size

        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            BoxLayout:
                orientation: 'vertical'
                size_hint: 0.85, None
                height: dp(90)
                spacing: dp(8)
                Label:
                    text: root.success_message
                    font_size: '14sp'
                    bold: True
                    color: (0.3, 0.9, 0.4, 1)
                    halign: 'center'
                    text_size: self.size
                Label:
                    text: 'Please wait...'
                    font_size: '11sp'
                    color: (1, 1, 1, 0.6)
                    halign: 'center'
