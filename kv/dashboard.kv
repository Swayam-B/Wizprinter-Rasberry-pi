# dashboard.kv — 800x480 layout
# Header bar taller; three action tiles in a wider grid; more breathing room.

<DashboardScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # ── Header ──────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: [dp(20), dp(8)]
            canvas.before:
                Color:
                    rgba: BG_DARK
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.075, 0.498, 0.925, 0.25
                Line:
                    points: [self.x, self.y, self.right, self.y]

            # Logo spacer
            Widget:
                size_hint_x: None
                width: dp(42)

            Label:
                text: 'WizPrinter'
                font_size: '20sp'
                bold: True
                color: WHITE
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Widget:

            # Status pill
            BoxLayout:
                size_hint_x: None
                width: dp(160)
                spacing: dp(8)

                Widget:
                    size_hint: None, None
                    size: dp(10), dp(10)
                    pos_hint: {'center_y': 0.5}
                    canvas:
                        Color:
                            rgba: SUCCESS_COLOR
                        Ellipse:
                            pos: self.pos
                            size: dp(10), dp(10)

                Label:
                    text: 'READY'
                    font_size: '12sp'
                    color: 1, 1, 1, 0.5
                    size_hint_x: None
                    width: dp(50)

                Label:
                    text: root.current_time
                    font_size: '16sp'
                    bold: True
                    color: WHITE
                    size_hint_x: None
                    width: dp(90)
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

        # ── Tile Grid ───────────────────────────────────────
        # Three equal tiles across the full width with generous padding.
        BoxLayout:
            orientation: 'horizontal'
            padding: [dp(24), dp(20), dp(24), dp(20)]
            spacing: dp(20)
            size_hint_y: 1

            # GRADE tile
            Button:
                font_size: '28sp'
                bold: True
                color: PRIMARY_COLOR
                background_color: 0, 0, 0, 0
                on_release: root.nav_classes()
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]
                    Color:
                        rgba: 0.3, 0.35, 0.45, 1
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 16]
                BoxLayout:
                    orientation: 'vertical'
                    center: self.parent.center
                    size: self.parent.size
                    spacing: dp(8)
                    Widget:
                    Label:
                        text: '[b]GRADE[/b]'
                        markup: True
                        font_size: '26sp'
                        color: PRIMARY_COLOR
                        halign: 'center'
                        size_hint_y: None
                        height: dp(40)
                    Label:
                        text: 'Grade exams'
                        font_size: '12sp'
                        color: TEXT_MUTED
                        halign: 'center'
                        size_hint_y: None
                        height: dp(20)
                    Widget:

            # SCAN tile
            Button:
                font_size: '28sp'
                bold: True
                color: PRIMARY_COLOR
                background_color: 0, 0, 0, 0
                on_release: root.nav_scan()
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]
                    Color:
                        rgba: 0.3, 0.35, 0.45, 1
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 16]
                BoxLayout:
                    orientation: 'vertical'
                    center: self.parent.center
                    size: self.parent.size
                    spacing: dp(8)
                    Widget:
                    Label:
                        text: '[b]SCAN[/b]'
                        markup: True
                        font_size: '26sp'
                        color: PRIMARY_COLOR
                        halign: 'center'
                        size_hint_y: None
                        height: dp(40)
                    Label:
                        text: 'Scan document'
                        font_size: '12sp'
                        color: TEXT_MUTED
                        halign: 'center'
                        size_hint_y: None
                        height: dp(20)
                    Widget:

            # SETTINGS tile
            Button:
                font_size: '28sp'
                bold: True
                color: PRIMARY_COLOR
                background_color: 0, 0, 0, 0
                on_release: root.nav_settings()
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]
                    Color:
                        rgba: 0.3, 0.35, 0.45, 1
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 16]
                BoxLayout:
                    orientation: 'vertical'
                    center: self.parent.center
                    size: self.parent.size
                    spacing: dp(8)
                    Widget:
                    Label:
                        text: '[b]SETTINGS[/b]'
                        markup: True
                        font_size: '26sp'
                        color: PRIMARY_COLOR
                        halign: 'center'
                        size_hint_y: None
                        height: dp(40)
                    Label:
                        text: 'Configure'
                        font_size: '12sp'
                        color: TEXT_MUTED
                        halign: 'center'
                        size_hint_y: None
                        height: dp(20)
                    Widget:

    # ── Floating Logo ────────────────────────────────────────
    Image:
        source: 'assets/logo/whiteLogo.png'
        size_hint: (None, None)
        size: dp(80), dp(80)
        pos: (dp(2), root.height - self.height + dp(14))
        allow_stretch: True
        keep_ratio: True
