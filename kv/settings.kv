<ClockIcon@Widget>:
    canvas:
        Color:
            rgba: WHITE
        Line:
            circle: [self.center_x, self.center_y, dp(11)]
            width: 1.6
        Line:
            points: [self.center_x, self.center_y, self.center_x, self.center_y + dp(6)]
            width: 1.6
        Line:
            points: [self.center_x, self.center_y, self.center_x + dp(5), self.center_y - dp(2)]
            width: 1.6

<WifiIcon@Widget>:
    canvas:
        Color:
            rgba: WHITE
        Line:
            circle: [self.center_x, self.center_y - dp(6), dp(2)]
            width: 1.6
        Line:
            circle: [self.center_x, self.center_y - dp(6), dp(7), 215, 325]
            width: 1.6
        Line:
            circle: [self.center_x, self.center_y - dp(6), dp(12), 215, 325]
            width: 1.6

<AccessibilityIcon@Widget>:
    canvas:
        Color:
            rgba: WHITE
        Line:
            circle: [self.center_x, self.center_y + dp(9), dp(3.5)]
            width: 1.6
        Line:
            points: [self.center_x - dp(8), self.center_y + dp(2), self.center_x + dp(8), self.center_y + dp(2)]
            width: 1.6
        Line:
            points: [self.center_x, self.center_y + dp(2), self.center_x, self.center_y - dp(4)]
            width: 1.6
        Line:
            points: [self.center_x, self.center_y - dp(4), self.center_x - dp(6), self.center_y - dp(11)]
            width: 1.6
        Line:
            points: [self.center_x, self.center_y - dp(4), self.center_x + dp(6), self.center_y - dp(11)]
            width: 1.6

<PowerIcon@Widget>:
    canvas:
        Color:
            rgba: DANGER_COLOR
        Line:
            circle: [self.center_x, self.center_y - dp(1), dp(9), -60, 240]
            width: 1.8
        Line:
            points: [self.center_x, self.center_y + dp(9), self.center_x, self.center_y - dp(2)]
            width: 1.8

<SettingsScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        StatusBar:
            size_hint_y: None
            height: dp(45)
            title: 'System Settings'
            show_back: True
            on_back: root.go_back()

        # ── Settings list ─────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'vertical'
            padding: ['20dp', '10dp']
            spacing: '10dp'

            Widget:
                size_hint_y: None
                height: '8dp'

            # Time/Region
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.open_time_region()
                canvas.before:
                    Color:
                        rgba: PRIMARY_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    ClockIcon:
                        size_hint_x: None
                        width: '36dp'
                    Label:
                        text: 'Time & Region'
                        font_size: '16sp'
                        bold: True
                        color: WHITE
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: 1, 1, 1, 0.6

            # Network Config — navigates to WiFi, does NOT force re-login
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.open_network_config()
                canvas.before:
                    Color:
                        rgba: PRIMARY_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    WifiIcon:
                        size_hint_x: None
                        width: '36dp'
                    Label:
                        text: 'Network Config'
                        font_size: '16sp'
                        bold: True
                        color: WHITE
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: 1, 1, 1, 0.6

            # Accessibility
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.open_accessibility()
                canvas.before:
                    Color:
                        rgba: PRIMARY_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    AccessibilityIcon:
                        size_hint_x: None
                        width: '36dp'
                    Label:
                        text: 'Accessibility'
                        font_size: '16sp'
                        bold: True
                        color: WHITE
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: 1, 1, 1, 0.6

            # Get Help — remote support hook (fleet-ops MVP)
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.request_help()
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                    Color:
                        rgba: BORDER_COLOR
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 12]
                        width: 1
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    Label:
                        text: '?'
                        font_size: '20sp'
                        bold: True
                        color: WHITE
                        size_hint_x: None
                        width: '36dp'
                        halign: 'center'
                    Label:
                        text: 'Get Help'
                        font_size: '16sp'
                        bold: True
                        color: WHITE
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: 1, 1, 1, 0.6

            # Log Out
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.logout()
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                    Color:
                        rgba: DANGER_COLOR
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 12]
                        width: 1
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    PowerIcon:
                        size_hint_x: None
                        width: '36dp'
                    Label:
                        text: 'Log Out'
                        font_size: '16sp'
                        bold: True
                        color: DANGER_COLOR
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: DANGER_COLOR

            Widget:

        # ── Footer ────────────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: '28dp'
            padding: ['20dp', '0dp', '20dp', '8dp']
            Label:
                text: 'PRINTER READY'
                font_size: '9sp'
                bold: True
                color: 0.4, 0.4, 0.4, 1
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                letter_spacing: 1
            Label:
                text: 'v2.5.0'
                font_size: '9sp'
                color: 0.4, 0.4, 0.4, 1
                text_size: self.size
                halign: 'right'
                valign: 'middle'
