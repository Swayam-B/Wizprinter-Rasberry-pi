<SettingsScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        StatusBar:
            size_hint_y: None
            height: dp(45)
            title: 'System Settings'
            show_back: True
            on_back: root.go_back()

        # ── Settings list ─────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'vertical'
            padding: ['20dp', '10dp']
            spacing: '10dp'

            Widget:
                size_hint_y: None
                height: '8dp'

            # Time/Region
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.open_time_region()
                canvas.before:
                    Color:
                        rgba: PRIMARY_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    Label:
                        text: '🕐'
                        font_size: '22sp'
                        size_hint_x: None
                        width: '36dp'
                        halign: 'center'
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Time & Region'
                            font_size: '16sp'
                            bold: True
                            color: WHITE
                            text_size: self.size
                            halign: 'left'
                            valign: 'middle'
                        Label:
                            text: 'Current: ' + root.current_tz
                            font_size: '11sp'
                            color: 1, 1, 1, 0.7
                            text_size: self.size
                            halign: 'left'
                            valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: 1, 1, 1, 0.6

            # Network Config — navigates to WiFi, does NOT force re-login
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.open_network_config()
                canvas.before:
                    Color:
                        rgba: PRIMARY_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    Label:
                        text: '📶'
                        font_size: '22sp'
                        size_hint_x: None
                        width: '36dp'
                        halign: 'center'
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Network Config'
                            font_size: '16sp'
                            bold: True
                            color: WHITE
                            text_size: self.size
                            halign: 'left'
                            valign: 'middle'
                        Label:
                            text: 'Change Wi-Fi — no sign-in required'
                            font_size: '11sp'
                            color: 1, 1, 1, 0.7
                            text_size: self.size
                            halign: 'left'
                            valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: 1, 1, 1, 0.6

            # Accessibility toggle row (high-contrast hint)
            BoxLayout:
                size_hint_y: None
                height: '40dp'
                padding: ['4dp', 0]
                Label:
                    text: 'Accessibility: set A11Y_HIGH_CONTRAST=1 or A11Y_TTS=1 in .env'
                    font_size: '10sp'
                    color: TEXT_MUTED
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'

            # Log Out
            Button:
                size_hint_y: None
                height: '58dp'
                background_color: TRANSPARENT
                on_release: root.logout()
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
                    Color:
                        rgba: DANGER_COLOR
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 12]
                        width: 1
                BoxLayout:
                    padding: ['16dp', '0dp']
                    spacing: '12dp'
                    pos: self.parent.pos
                    size: self.parent.size
                    Label:
                        text: '⏻'
                        font_size: '22sp'
                        color: DANGER_COLOR
                        size_hint_x: None
                        width: '36dp'
                        halign: 'center'
                    Label:
                        text: 'Log Out'
                        font_size: '16sp'
                        bold: True
                        color: DANGER_COLOR
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        size_hint_x: None
                        width: '24dp'
                        text: '›'
                        font_size: '22sp'
                        color: DANGER_COLOR

            Widget:

        # ── Footer ────────────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: '28dp'
            padding: ['20dp', '0dp', '20dp', '8dp']
            Label:
                text: 'PRINTER READY'
                font_size: '9sp'
                bold: True
                color: 0.4, 0.4, 0.4, 1
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                letter_spacing: 1
            Label:
                text: 'v2.5.0'
                font_size: '9sp'
                color: 0.4, 0.4, 0.4, 1
                text_size: self.size
                halign: 'right'
                valign: 'middle'
