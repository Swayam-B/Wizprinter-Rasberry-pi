# preview.kv — 800x480 layout
# PDF preview fills a much larger central area; action buttons are row-based
# and sit in a proper footer bar rather than floating over the content.

<PreviewScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # ── Header ──────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            padding: [dp(12), dp(6)]
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: BG_DARK
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 1, 1, 1, 0.1
                Line:
                    points: [self.x, self.y, self.right, self.y]

            # Back button
            Button:
                size_hint: None, 1
                width: dp(44)
                background_color: TRANSPARENT
                on_release: root.go_back()
                Widget:
                    center: self.parent.center
                    size: dp(20), dp(20)
                    canvas:
                        Color:
                            rgba: WHITE
                        Line:
                            width: 1.5
                            points: [self.center_x + dp(5), self.center_y - dp(7), self.center_x - dp(5), self.center_y, self.center_x + dp(5), self.center_y + dp(7)]

            Label:
                text: 'Document Preview'
                font_size: '17sp'
                bold: True
                color: WHITE
                text_size: self.size
                halign: 'left'
                valign: 'middle'

            Widget:

            Label:
                size_hint_x: None
                width: dp(80)
                text: root.page_info
                font_size: '12sp'
                color: TEXT_MUTED
                text_size: self.size
                halign: 'right'
                valign: 'middle'

        # ── PDF Viewer ───────────────────────────────────────
        # The viewer now uses ~86% of the remaining vertical space,
        # with comfortable horizontal margins to show the dark background.
        ScrollView:
            id: scroll_container
            size_hint: (1, 1)
            do_scroll_x: False
            do_scroll_y: True

            # White page container
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(40), dp(16)]
                spacing: dp(0)
                canvas.before:
                    Color:
                        rgba: BG_DARK
                    Rectangle:
                        pos: self.pos
                        size: self.size

                GridLayout:
                    id: preview_container
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(12)
                    padding: [0, dp(4)]
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [6]

        # ── Action Footer ────────────────────────────────────
        # Full-width button row — no floating, no overlap.
        BoxLayout:
            size_hint_y: None
            height: dp(72)
            padding: [dp(24), dp(10)]
            spacing: dp(16)
            canvas.before:
                Color:
                    rgba: BG_SURFACE
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 1, 1, 1, 0.08
                Line:
                    points: [self.x, self.top, self.right, self.top]

            # DELETE
            Button:
                background_color: TRANSPARENT
                on_release: root.delete_document()
                canvas.before:
                    Color:
                        rgba: DANGER_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: 'DELETE'
                    font_size: '13sp'
                    bold: True
                    color: WHITE
                    center: self.parent.center

            # GRADE (wider / primary)
            Button:
                size_hint_x: 1.4
                background_color: TRANSPARENT
                on_release: root.grade_document()
                canvas.before:
                    Color:
                        rgba: PRIMARY_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: 'GRADE'
                    font_size: '15sp'
                    bold: True
                    color: WHITE
                    center: self.parent.center

            # PRINT
            Button:
                background_color: TRANSPARENT
                on_release: root.print_document()
                canvas.before:
                    Color:
                        rgba: SUCCESS_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: 'PRINT'
                    font_size: '13sp'
                    bold: True
                    color: WHITE
                    center: self.parent.center

    # ── Success overlay ──────────────────────────────────────
    FloatLayout:
        size_hint: 1, 1
        opacity: 1 if root.show_success else 0

        canvas.before:
            Color:
                rgba: (0, 0, 0, 0.85) if root.show_success else (0, 0, 0, 0)
            Rectangle:
                pos: self.pos
                size: self.size

        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            BoxLayout:
                orientation: 'vertical'
                size_hint: (None, None)
                size: dp(360), dp(100)
                spacing: dp(10)
                Label:
                    text: root.success_message
                    font_size: '18sp'
                    bold: True
                    color: (0.3, 0.9, 0.4, 1)
                    halign: 'center'
                    text_size: self.size
                Label:
                    text: 'Please wait...'
                    font_size: '13sp'
                    color: (1, 1, 1, 0.6)
                    halign: 'center'
                    text_size: self.size
