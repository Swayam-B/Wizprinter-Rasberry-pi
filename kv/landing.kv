# landing.kv — 800x480
# BUG FIX: replaced FloatLayout with a plain BoxLayout (vertical).
# FloatLayout children are drawn bottom-to-top; an inner FloatLayout
# with size_hint_y covering the branding region was acting as an
# invisible shield over the button.  A BoxLayout has no such overlap.

<LandingScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [dp(24), dp(20)]
        spacing: dp(16)

        # 1. BRANDING GROUP — centred image + title
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 1
            spacing: dp(4)

            Image:
                source: 'assets/logo/whiteLogo.png'
                size_hint: (1, 1)
                allow_stretch: True
                keep_ratio: True

            Label:
                text: 'WizPrinter'
                font_size: '38sp'
                bold: True
                color: [1, 1, 1, 1]
                size_hint_y: None
                height: dp(52)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

        # 2. THE BUTTON — lives below the branding, never overlapped
        Button:
            text: 'TAP TO START'
            size_hint: (0.75, None)
            height: dp(65)
            pos_hint: {'center_x': 0.5}
            font_size: '22sp'
            bold: True
            color: [1, 1, 1, 1]
            background_color: 0, 0, 0, 0
            on_release: root.on_tap_start()
            canvas.before:
                Color:
                    rgba: PRIMARY_COLOR
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]
