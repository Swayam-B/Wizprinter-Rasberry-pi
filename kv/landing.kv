<LandingScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        # 1. THE LOGO - Forced to a large, visible size
        Image:
            source: 'assets/logo/whiteLogo.png'
            size_hint: None, None
            size: dp(280), dp(280) # Explicitly large
            pos_hint: {'center_x': 0.5, 'center_y': 0.65}
            allow_stretch: True
            keep_ratio: True

        # 2. THE BRAND NAME
        Label:
            text: 'WizPrinter'
            font_size: '60sp'
            bold: True
            color: [1, 1, 1, 1]
            size_hint: None, None
            size: self.texture_size
            pos_hint: {'center_x': 0.5, 'center_y': 0.42}

        # 3. THE BUTTON - Wide and tall for 800px width
        Button:
            text: 'TAP TO START'
            size_hint: None, None
            size: dp(500), dp(90) # Explicitly wide/tall for the kiosk
            pos_hint: {'center_x': 0.5, 'y': 0.12}
            font_size: '32sp'
            bold: True
            color: [1, 1, 1, 1]
            background_color: [0, 0, 0, 0]
            on_release: root.on_tap_start()
            canvas.before:
                Color:
                    rgba: PRIMARY # Your brand blue/green
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]