<LandingScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        # 1. BRANDING GROUP
        FloatLayout:
            size_hint: (None, None)
            size: dp(300), dp(350)
            # Keeping the whole group pinned near the top
            pos_hint: {'center_x': 0.5, 'top': 0.95}

            Image:
                source: 'assets/logo/whiteLogo.png'
                size_hint: (None, None)
                size: dp(250), dp(250)
                pos_hint: {'center_x': 0.5, 'top': 1} 
                allow_stretch: True
                keep_ratio: True

            Label:
                text: 'WizPrinter'
                font_size: '48sp'
                bold: True
                color: [1, 1, 1, 1]
                size_hint: (None, None)
                size: self.texture_size
                pos_hint: {'center_x': 0.5, 'center_y': 0.3}

        # 2. THE BUTTON
        Button:
            text: 'TAP TO START'
            size_hint: (0.7, None)
            height: dp(80)
            pos_hint: {'center_x': 0.5, 'y': 0.15}
            font_size: '26sp'
            bold: True
            color: [1, 1, 1, 1]
            background_color: 0, 0, 0, 0
            on_release: root.on_tap_start()
            canvas.before:
                Color:
                    rgba: PRIMARY_COLOR
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]