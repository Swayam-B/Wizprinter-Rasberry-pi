#:import dp kivy.metrics.dp

<DocumentsScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        StatusBar:
            size_hint_y: None
            height: dp(45)
            title: 'Select Exam'
            show_back: True
            on_back: root.go_back()

        Label:
            text: root.status_text
            size_hint_y: None
            height: dp(24)
            font_size: '12sp'
            color: 1, 0.8, 0.2, 1

        ScrollView:
            size_hint_y: 1
            do_scroll_x: False
            BoxLayout:
                id: doc_list
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        BottomNav:
            active_tab: 'documents'
            size_hint_y: None
            height: dp(45)
