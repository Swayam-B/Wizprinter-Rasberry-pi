# wifi.kv — 800x480 layout
# Network list on left (40%), keyboard area on right (60%).

<WifiScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # ── Header ──────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            padding: [dp(20), dp(8)]
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: BG_DARK
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'WiFi'
                font_size: '18sp'
                bold: True
                color: PRIMARY_COLOR
                size_hint_x: None
                width: dp(40)
            Label:
                text: 'SELECT NETWORK'
                font_size: '13sp'
                bold: True
                color: 0.075, 0.498, 0.925, 0.8
                text_size: self.size
                halign: 'left'
                valign: 'middle'

        # ── Side-by-side body ────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            padding: [dp(16), dp(8), dp(16), dp(12)]
            spacing: dp(16)

            # Left: network list
            BoxLayout:
                size_hint_x: 0.4
                orientation: 'vertical'
                spacing: dp(4)
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]

                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height

                        Button:
                            size_hint_y: None
                            height: dp(52)
                            background_color: TRANSPARENT
                            on_release: root.select_network('WizPrinter_Guest')
                            canvas.before:
                                Color:
                                    rgba: 0.075, 0.498, 0.925, 0.18
                                Rectangle:
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: PRIMARY_COLOR
                                Rectangle:
                                    pos: self.pos
                                    size: 4, self.height
                            Label:
                                text: 'WizPrinter_Guest'
                                font_size: '14sp'
                                bold: True
                                color: WHITE
                                center: self.parent.center

                        Button:
                            size_hint_y: None
                            height: dp(52)
                            background_color: TRANSPARENT
                            on_release: root.select_network('Office_WiFi')
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 0.03
                                Line:
                                    points: [self.x, self.y, self.right, self.y]
                            Label:
                                text: 'Office_WiFi'
                                font_size: '14sp'
                                color: WHITE
                                center: self.parent.center

                        Button:
                            size_hint_y: None
                            height: dp(52)
                            background_color: TRANSPARENT
                            on_release: root.select_network('Public_Net')
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 0.03
                                Line:
                                    points: [self.x, self.y, self.right, self.y]
                            Label:
                                text: 'Public_Net'
                                font_size: '14sp'
                                color: WHITE
                                center: self.parent.center

            # Right: keyboard placeholder
            BoxLayout:
                size_hint_x: 0.6
                padding: dp(20)
                canvas.before:
                    Color:
                        rgba: 0.086, 0.114, 0.149, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]

                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(12)
                    padding: dp(16)
                    canvas.before:
                        Color:
                            rgba: BORDER_COLOR
                        Line:
                            rectangle: self.x, self.y, self.width, self.height
                            dash_length: 8
                            dash_offset: 4

                    Widget:
                        size_hint_y: 0.3

                    Label:
                        text: 'VIRTUAL KEYBOARD'
                        font_size: '13sp'
                        bold: True
                        color: 1, 1, 1, 0.8
                        size_hint_y: 0.15
                        halign: 'center'
                        text_size: self.size

                    Label:
                        text: 'Password entry area'
                        font_size: '11sp'
                        color: BORDER_COLOR
                        size_hint_y: 0.1
                        halign: 'center'
                        text_size: self.size

                    AnchorLayout:
                        size_hint_y: 0.25
                        Button:
                            size_hint: None, None
                            size: dp(200), dp(44)
                            background_color: TRANSPARENT
                            on_release: root.select_network('WizPrinter_Guest')
                            canvas.before:
                                Color:
                                    rgba: PRIMARY_COLOR
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [22]
                            Label:
                                text: 'CONNECT'
                                font_size: '13sp'
                                bold: True
                                color: WHITE
                                center: self.parent.center

                    Widget:
                        size_hint_y: 0.2
