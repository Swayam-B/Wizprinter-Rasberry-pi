<WifiScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:

        # ── Main content ──────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'vertical'
            size: root.size
            pos: root.pos

            # Header
            StatusBar:
                size_hint_y: None
                height: dp(45)
                title: 'WiFi Setup'
                show_back: True
                on_back: root.go_back()

            BoxLayout:
                size_hint_y: None
                height: '22dp'
                padding: ['14dp', '0dp']
                Label:
                    text: 'SELECT NETWORK'
                    font_size: '13sp'
                    bold: True
                    color: 0.075, 0.498, 0.925, 0.8
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
                Label:
                    text: root.scan_status
                    font_size: '11sp'
                    color: (0.3, 1, 0.5, 1) if root.networks else (0.9, 0.6, 0.2, 1)
                    text_size: self.size
                    halign: 'right'
                    valign: 'middle'

            # Connect status bar
            Label:
                text: root.connect_status
                size_hint_y: None
                height: '26dp' if root.connect_status else '0dp'
                opacity: 1 if root.connect_status else 0
                font_size: '13sp'
                bold: True
                color: (0.3, 1, 0.5, 1) if root.connect_status.startswith('\u2713') else (1, 0.4, 0.4, 1)
                halign: 'center'

            # Network list
            ScrollView:
                size_hint_y: 1
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: '2dp'

                    # Scanning spinner row
                    BoxLayout:
                        size_hint_y: None
                        height: '48dp' if root.is_scanning else '0dp'
                        opacity: 1 if root.is_scanning else 0
                        canvas.before:
                            Color:
                                rgba: 0.098, 0.149, 0.200, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size
                        Label:
                            text: 'Scanning\u2026'
                            font_size: '13sp'
                            color: TEXT_MUTED
                            halign: 'center'

                    # No networks found
                    BoxLayout:
                        size_hint_y: None
                        height: '64dp' if (not root.networks and not root.is_scanning) else '0dp'
                        opacity: 1 if (not root.networks and not root.is_scanning) else 0
                        orientation: 'vertical'
                        padding: '16dp'
                        Label:
                            text: 'No networks found.\nTap Refresh to scan again.'
                            font_size: '13sp'
                            color: 1, 0.6, 0.3, 1
                            halign: 'center'

                    # Dynamically populated network rows
                    BoxLayout:
                        id: network_rows
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height

            # Bottom buttons
            BoxLayout:
                size_hint_y: None
                height: '54dp'
                padding: '14dp', '7dp'
                spacing: '10dp'

                Button:
                    text: '\u21ba  REFRESH'
                    font_size: '13sp'
                    bold: True
                    size_hint_x: 0.5
                    disabled: root.is_scanning or root.is_connecting
                    background_color: TRANSPARENT
                    on_release: root.refresh()
                    canvas.before:
                        Color:
                            rgba: (0.15, 0.22, 0.30, 1) if self.disabled else BORDER_COLOR
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]

                Button:
                    text: 'SKIP'
                    font_size: '13sp'
                    size_hint_x: 0.5
                    background_color: TRANSPARENT
                    on_release: app.navigate('login')
                    canvas.before:
                        Color:
                            rgba: (0.10, 0.15, 0.20, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]

        # ── Password prompt modal ─────────────────────────────────────────────
        # Sits high on the screen so the docked on-screen keyboard (bottom half)
        # doesn't cover the password field while typing.
        BoxLayout:
            id: pwd_modal
            size_hint: None, None
            size: '400dp', '230dp'
            pos_hint: {'center_x': 0.5, 'top': 0.98}
            opacity: 1 if root.show_password_prompt else 0
            disabled: not root.show_password_prompt
            orientation: 'vertical'
            padding: '18dp'
            spacing: '10dp'
            canvas.before:
                Color:
                    rgba: 0.055, 0.086, 0.118, 0.97
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]
                Color:
                    rgba: PRIMARY_COLOR
                Line:
                    rounded_rectangle: [self.x, self.y, self.width, self.height, 14]
                    width: 1.2

            Label:
                text: 'Password for'
                font_size: '11sp'
                color: TEXT_MUTED
                size_hint_y: None
                height: '16dp'
                halign: 'center'

            Label:
                text: root.prompt_ssid
                font_size: '15sp'
                bold: True
                color: WHITE
                size_hint_y: None
                height: '22dp'
                halign: 'center'
                text_size: self.size

            # Input row — border color driven by root property, not canvas id ref
            BoxLayout:
                id: pwd_input_row
                size_hint_y: None
                height: '44dp'
                spacing: '0dp'
                canvas.before:
                    Color:
                        rgba: BG_SURFACE
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                    Color:
                        rgba: (0.075, 0.498, 0.925, 0.8) if root.pwd_focused else BORDER_COLOR
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
                        width: 1.2

                TextInput:
                    id: pwd_input
                    hint_text: 'Network password'
                    password: not root.password_visible
                    multiline: False
                    font_size: '15sp'
                    background_color: TRANSPARENT
                    foreground_color: 1, 1, 1, 1
                    hint_text_color: TEXT_MUTED
                    cursor_color: PRIMARY_COLOR
                    padding: ['14dp', '10dp']
                    on_focus: root.pwd_focused = self.focus

                Button:
                    text: 'Hide' if root.password_visible else 'Show'
                    size_hint_x: None
                    width: '60dp'
                    font_size: '12sp'
                    bold: True
                    background_color: TRANSPARENT
                    color: TEXT_MUTED
                    on_release: root.toggle_password_visible()

            BoxLayout:
                size_hint_y: None
                height: '42dp'
                spacing: '10dp'

                Button:
                    text: 'Cancel'
                    font_size: '13sp'
                    background_color: TRANSPARENT
                    on_release: root.cancel_password()
                    canvas.before:
                        Color:
                            rgba: BORDER_COLOR
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]

                Button:
                    text: 'Connect'
                    font_size: '13sp'
                    bold: True
                    background_color: TRANSPARENT
                    on_release: root.confirm_password(pwd_input.text)
                    canvas.before:
                        Color:
                            rgba: PRIMARY_COLOR
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
