# login.kv — 800x480 layout
# Form centred in a constrained card; extra horizontal space used for margins.

<LoginScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        StatusBar:
            title: 'User Login'
            hide_home: True
            show_back: True
            on_back: root.manager.current = 'landing'

        # Card container — max width keeps the form readable on wide display
        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'

            BoxLayout:
                orientation: 'vertical'
                size_hint: (None, None)
                size: dp(400), dp(340)
                spacing: dp(12)
                padding: [dp(32), dp(24)]
                canvas.before:
                    Color:
                        rgba: BG_CARD
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]
                    Color:
                        rgba: BORDER_COLOR
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 16]

                Label:
                    text: 'Sign In'
                    font_size: '22sp'
                    bold: True
                    color: WHITE
                    size_hint_y: None
                    height: dp(36)
                    halign: 'left'
                    text_size: self.size

                # Username
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(62)
                    spacing: dp(4)
                    Label:
                        text: 'Username'
                        font_size: '12sp'
                        color: TEXT_MUTED
                        size_hint_y: None
                        height: dp(18)
                        text_size: self.size
                        halign: 'left'
                    TextInput:
                        id: username_input
                        hint_text: 'Enter username'
                        font_size: '15sp'
                        size_hint_y: None
                        height: dp(40)
                        multiline: False
                        background_color: BG_SURFACE
                        foreground_color: WHITE
                        hint_text_color: TEXT_MUTED
                        cursor_color: PRIMARY_COLOR
                        padding: [dp(14), dp(10)]

                # Password
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(62)
                    spacing: dp(4)
                    Label:
                        text: 'Password'
                        font_size: '12sp'
                        color: TEXT_MUTED
                        size_hint_y: None
                        height: dp(18)
                        text_size: self.size
                        halign: 'left'
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        TextInput:
                            id: password_input
                            hint_text: 'Password'
                            font_size: '15sp'
                            multiline: False
                            password: not root.password_visible
                            background_color: BG_SURFACE
                            foreground_color: WHITE
                            hint_text_color: TEXT_MUTED
                            cursor_color: PRIMARY_COLOR
                            padding: [dp(14), dp(10)]
                        Button:
                            size_hint_x: None
                            width: dp(44)
                            background_color: BG_SURFACE
                            on_release: root.toggle_password()
                            Widget:
                                center: self.parent.center
                                size: dp(24), dp(16)
                                canvas:
                                    Color:
                                        rgba: PRIMARY_COLOR if root.password_visible else TEXT_MUTED
                                    Ellipse:
                                        pos: self.center_x - dp(12), self.center_y - dp(8)
                                        size: dp(24), dp(16)
                                    Color:
                                        rgba: BG_SURFACE
                                    Ellipse:
                                        pos: self.center_x - dp(5), self.center_y - dp(5)
                                        size: dp(10), dp(10)
                                    Color:
                                        rgba: (PRIMARY_COLOR if root.password_visible else [0,0,0,0])
                                    Ellipse:
                                        pos: self.center_x - dp(2), self.center_y - dp(2)
                                        size: dp(4), dp(4)

                Label:
                    text: root.status_text
                    font_size: '12sp'
                    color: 1, 0.3, 0.3, 1
                    size_hint_y: None
                    height: dp(20)
                    text_size: self.size
                    halign: 'center'

                Button:
                    size_hint_y: None
                    height: dp(48)
                    background_color: TRANSPARENT
                    on_release: root.attempt_login(username_input.text, password_input.text)
                    canvas.before:
                        Color:
                            rgba: PRIMARY_COLOR
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                    Label:
                        text: 'Login'
                        font_size: '17sp'
                        bold: True
                        color: WHITE
                        center: self.parent.center

        # Bottom home indicator
        AnchorLayout:
            size_hint_y: None
            height: dp(20)
            Widget:
                size_hint: None, None
                size: dp(80), dp(4)
                canvas:
                    Color:
                        rgba: 0.3, 0.3, 0.3, 0.5
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [2]
