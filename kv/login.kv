<LoginScreen>:
    canvas.before:
        Color:
            rgba: BG_DARK
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Status bar with back button
        StatusBar:
            title: 'Sign In'
            hide_home: True
            show_back: True
            on_back: root.go_back()

        # Form content
        BoxLayout:
            orientation: 'vertical'
            padding: ['20dp', '12dp']
            spacing: '10dp'

            # Email field
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: '64dp'
                spacing: '4dp'

                Label:
                    text: 'Email'
                    font_size: '13sp'
                    bold: True
                    color: WHITE
                    size_hint_y: None
                    height: '18dp'
                    text_size: self.size
                    halign: 'left'

                # Border color driven by root.email_focused — never refs id in canvas
                BoxLayout:
                    size_hint_y: None
                    height: '42dp'
                    canvas.before:
                        Color:
                            rgba: BG_SURFACE
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
                        Color:
                            rgba: (0.075, 0.498, 0.925, 0.6) if root.email_focused else BORDER_COLOR
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
                            width: 1.2

                    TextInput:
                        id: username_input
                        hint_text: 'Enter your email'
                        font_size: '15sp'
                        multiline: False
                        background_color: TRANSPARENT
                        foreground_color: 1, 1, 1, 1
                        hint_text_color: TEXT_MUTED
                        cursor_color: PRIMARY_COLOR
                        padding: ['14dp', '10dp']
                        on_focus: root.email_focused = self.focus

            # Password field
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: '64dp'
                spacing: '4dp'

                Label:
                    text: 'Password'
                    font_size: '13sp'
                    bold: True
                    color: WHITE
                    size_hint_y: None
                    height: '18dp'
                    text_size: self.size
                    halign: 'left'

                BoxLayout:
                    size_hint_y: None
                    height: '42dp'
                    canvas.before:
                        Color:
                            rgba: BG_SURFACE
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
                        Color:
                            rgba: (0.075, 0.498, 0.925, 0.6) if root.pwd_focused else BORDER_COLOR
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
                            width: 1.2

                    TextInput:
                        id: password_input
                        hint_text: 'Password'
                        font_size: '15sp'
                        multiline: False
                        password: not root.password_visible
                        background_color: TRANSPARENT
                        foreground_color: 1, 1, 1, 1
                        hint_text_color: TEXT_MUTED
                        cursor_color: PRIMARY_COLOR
                        padding: ['14dp', '10dp']
                        on_focus: root.pwd_focused = self.focus

                    Button:
                        size_hint_x: None
                        width: '60dp'
                        font_size: '12sp'
                        bold: True
                        background_color: TRANSPARENT
                        color: TEXT_MUTED
                        on_release: root.toggle_password()
                        Label:
                            text: 'Hide' if root.password_visible else 'Show'
                            font_size: '12sp'
                            color: TEXT_MUTED
                            center: self.parent.center

            # Status / error message
            Label:
                text: root.status_text
                font_size: '12sp'
                color: 1, 0.35, 0.35, 1
                size_hint_y: None
                height: '22dp'
                text_size: self.size
                halign: 'center'
                opacity: 1 if root.status_text else 0

            # Login button
            Button:
                size_hint_y: None
                height: '52dp'
                background_color: TRANSPARENT
                disabled: root.is_loading
                on_release: root.attempt_login(username_input.text, password_input.text)
                canvas.before:
                    Color:
                        rgba: (0.05, 0.35, 0.65, 1) if self.disabled else PRIMARY_COLOR
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: 'Signing in\u2026' if root.is_loading else 'Sign In'
                    font_size: '17sp'
                    bold: True
                    color: WHITE
                    center: self.parent.center

            Widget:

        AnchorLayout:
            size_hint_y: None
            height: '16dp'
            Widget:
                size_hint: None, None
                size: '80dp', '4dp'
                canvas:
                    Color:
                        rgba: 0.3, 0.3, 0.3, 0.5
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [2]
